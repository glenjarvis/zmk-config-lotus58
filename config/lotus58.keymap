#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


#define default_layer     0
#define symbol_layer      1
#define mouse_layer       2
#define function_layer    3
#define macos_flag_layer  4
#define macos_layer       5


/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        macos {
            if-layers = <symbol_layer macos_flag_layer>;
            then-layer = <macos_layer>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_dsklg {
            timeout-ms = <100>;
            key-positions = <24 52>;
            layers = <default_layer>;
            bindings = <&kp LGUI>;
        };
    };

    behaviors {
        fofunc: four_ffour {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp F4>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        sleft: s_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp S>, <&kp LEFT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
        fright: f_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp RIGHT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
/* ------------------------------------------------------|            |---------------------------------------------------------------|
 0|   ESC   |   1  |   2  |  3   | 4/F4  |   5  |        |            |                  |   6   |  7   |    8    |   9   |   0    |   -     |
12|   TAB   |   Q  |   W  |  E   |  R    |   T  |        |            |                  |   Y   |  U   |    I    |   O   |   P    |  BSPC   |
24|  SHIFT  |   A  |  S/← |  D   | F/→   |   G  |ink-disp|            | [knob]           |   H   |  J   |    K    |   L   |   ;    | ' SFT   |
38|   CTRL  |   Z  |   X  |  C   |  V    |   B  |Ms Layer|            |  Function Layer  |   N   |  M   |    ,    |   .   |   /    | \ CTRL  |
52|                     LGUI | LALT | Symbol Layer | RET |            | SPACE            | Symbol Layer |   RALT | LGUI                       |
   ------------------------------------------------------|            |---------------------------------------------------------------*/
            bindings = <
   &kp ESC   &kp N1 &kp N2 &kp N3 &fofunc &kp N5                                          &kp N6  &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
   &kp TAB   &kp Q  &kp W  &kp E  &kp R   &kp T                                           &kp Y   &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LSHFT &kp A  &sleft &kp D  &fright &kp G   &trans               &kp C_MUTE         &kp H   &kp J  &kp K     &kp L   &kp SEMI &mt RSHFT SQT
   &kp LCTRL &kp Z  &kp X  &kp C  &kp V   &kp B   &mo mouse_layer    &mo function_layer  &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &mt RCTRL BSLH
              &kp LGUI &kp LALT  &mo symbol_layer &kp RET            &kp SPACE &mo symbol_layer &kp RALT &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbol_layer {
            display-name = "Symbol";

/* ---------------------------------------------------------------------|    |--------------------------------------------------------------------------|
 0|    ~    |    F1    |   F2     |   F3     |  F4      |  F5 |         |    |          |   F6      |  F7  |      F8     |  F9      |  F10    |   +     |
12|    `    |          |   HOME   |          |  END     |     |         |    |          |           | Pg Up|     Insert  |          | PSCRN   |   =     |
24|Caps Lock|  SELECT  |   SAVE   |          |          |     |ink-disp |    | [knob]   | Left      | Down |      Up     | Right    |   [     |   ]     |
38|         |   UNDO   |   CUT    |   COPY   |  PASTE   |     |         |    |          | Mute      |Pg Dwn|             |          |   {     |   }     |
52|                                       LGUI | LALT | Fn Layer | RET  |    |  SPACE | Fn Layer |   RALT | LGUI                                    |
   ---------------------------------------------------------------------|    |---------------------------------------------------------------------------

   Clipboard keys (SELECT, SAVE, UNDO, CUT, COPY, PASTE) use Ctrl equivalents
   (LC) as the OS-agnostic default (Linux/Windows). When MacOS layer is toggled
   on via Function + M, those same positions are overridden with Cmd equivalents
   (LG) for macOS.
   */

            bindings = <
   &kp TILDE &kp F1     &kp F2     &kp F3     &kp F4      &kp F5                         &kp F6      &kp F7     &kp F8    &kp F9     &kp F10   &kp PLUS
   &kp GRAVE &trans     &kp HOME   &trans     &kp END     &trans                         &trans      &kp PG_UP  &kp INS   &trans     &kp PSCRN &kp EQUAL
   &kp CLCK  &kp LC(A)     &kp LC(S)  &trans     &trans      &trans  &trans      &trans     &kp LEFT    &kp DOWN   &kp UP    &kp RIGHT  &kp LBKT  &kp RBKT
   &trans    &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &trans  &trans      &trans     &kp C_MUTE  &kp PG_DN  &trans    &trans     &kp LBRC  &kp RBRC
                                 &trans   &trans &mo function_layer  &trans    &trans    &mo function_layer &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };


        mouse_layer {
            display-name = "Mouse";

/* --------------------------------------------------|    |---------------------------------------------------------------------------------------|
 0|      |      |      |      |      |     |         |    |         |            |              |             |               |         |         |
12|      |      |      |      |      |     |         |    |         | M Scroll Up|              |             |               |         |         |
24|      |      |      |      |      |     |ink-disp |    | [knob]  | Mouse Left |M Down        |   Mouse Up  | M Right       |         |         |
38|      |      |      |      |      |     |         |    |         | M Scroll Dn|              |             |               |         |         |
52|                                                  |    | LCLICK  |   RCLICK   |                                                                |
   --------------------------------------------------|    |---------------------------------------------------------------------------------------*/
           

            bindings = <
   &trans &trans &trans &trans &trans &trans               &trans    &trans         &trans         &trans        &trans          &trans
   &trans &trans &trans &trans &trans &trans               &trans    &msc SCRL_UP   &trans         &trans        &trans          &trans
   &trans &trans &trans &trans &trans &trans &trans        &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP  &mmv MOVE_RIGHT &trans    &trans
   &trans &trans &trans &trans &trans &trans &trans        &trans    &msc SCRL_DOWN &trans         &trans        &trans          &trans    &trans
                        &trans &trans &trans &trans        &mkp LCLK &mkp RCLK      &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };


        function_layer {
            display-name = "Function";

/*
Left:
--------------------------------------------------------------------------------------|
 0|     BTCLR    |     BT1    |     BT2    |  BT3       | BT4        | BT5   |        |
12|              |            |            |            |            | Unlock|        |
24|              |            |            |            |            |       |ink-disp|
38|              |            |            |            |            |       |        |
52|                                                                                   |
   -----------------------------------------------------------------------------------|  


Right:
------------------------------------------------------------------------------------|
 0|   OUT_TOG    |   OUT_USB  |  Out BLE   |            | Reset      | Bootloader   |
12|              |            |            |            |            |              |
24|   [knob]     |            |            |            |            |              |
38|              |            | Mac Toggle |            |            |              |
52|              |            |            |            |            |              |
------------------------------------------------------------------------------------|
*/
           

            bindings = <

   &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
   &out OUT_TOG   &out OUT_USB &out OUT_BLE &trans       &sys_reset   &bootloader

   &trans         &trans       &trans       &trans       &trans       &studio_unlock
   &trans         &trans       &trans       &trans       &trans       &trans 
   
   &trans         &trans       &trans       &trans       &trans       &trans        &trans
   &trans         &trans       &trans       &trans       &trans       &trans        &trans
   
   &trans         &trans       &trans       &trans       &trans       &trans        &trans
   &trans         &trans       &tog macos_flag_layer &trans &trans      &trans        &trans

   &trans        &trans      &trans      &trans
   &trans        &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        macos_flag_layer {
            display-name = "MacOS";

/* Marker layer — all transparent. Toggled on/off via Function + M.
   When active simultaneously with symbol_layer, triggers macos_layer
   via conditional_layers to override clipboard keys with Cmd equivalents.
*/

            bindings = <
   &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans        &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        macos_layer {
            display-name = "Mac+Sym";

/* Conditional layer — activates only when both symbol_layer and
   macos_flag_layer are active. Overrides clipboard/editing keys
   with macOS Cmd equivalents at the same positions as symbol_layer.

   Row 24: SELECT (Cmd+A), SAVE (Cmd+S)
   Row 38: UNDO (Cmd+Z), CUT (Cmd+X), COPY (Cmd+C), PASTE (Cmd+V)
*/

            bindings = <
   &trans &trans    &trans    &trans    &trans    &trans               &trans &trans &trans &trans &trans &trans
   &trans &trans    &trans    &trans    &trans    &trans               &trans &trans &trans &trans &trans &trans
   &trans &kp LG(A) &kp LG(S) &trans    &trans    &trans &trans        &trans &trans &trans &trans &trans &trans &trans
   &trans &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &trans &trans      &trans &trans &trans &trans &trans &trans &trans
                          &trans &trans &trans &trans                  &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };

};
