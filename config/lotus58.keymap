#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


#define default_layer 0
#define lower_layer   1
#define raise_layer   2
#define adjust_layer  3
#define extra_layer   4
// To get to Adjust layer hold both Lower and Raise together.


/ {
    combos {
        compatible = "zmk,combos";
        combo_dsklg {
            timeout-ms = <100>;
            key-positions = <24 52>;
            layers = <0>;
            bindings = <&kp LGUI>;
        };
    };

    behaviors {
        fofunc: four_ffour {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp F4>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        sleft: s_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp S>, <&kp LEFT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
        fright: f_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp RIGHT>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
/* ------------------------------------------------------|    |---------------------------------------------------------------|
 0|   ESC   |   1  |   2  |  3   | 4/F4  |   5  |        |    |           |   6   |  7   |    8    |   9   |   0    |   -     |
12|   TAB   |   Q  |   W  |  E   |  R    |   T  |        |    |           |   Y   |  U   |    I    |   O   |   P    |  BSPC   |
24|  SHIFT  |   A  |  S/← |  D   | F/→   |   G  |ink-disp|    | [knob]    |   H   |  J   |    K    |   L   |   ;    | ' SFT   |
38|   CTRL  |   Z  |   X  |  C   |  V    |   B  |Adj Layr|    | Adj Layer |   N   |  M   |    ,    |   .   |   /    | \ CTRL  |
52|                      LGUI | LALT | Lower Layer | RET |    | SPACE     | Raise Layer |   RALT | LGUI                       |
   ------------------------------------------------------|    |---------------------------------------------------------------*/
            bindings = <
   &kp ESC   &kp N1 &kp N2 &kp N3 &fofunc &kp N5                           &kp N6  &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
   &kp TAB   &kp Q  &kp W  &kp E  &kp R   &kp T                            &kp Y   &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LSHFT &kp A  &sleft &kp D  &fright &kp G   &trans       &kp C_MUTE  &kp H   &kp J  &kp K     &kp L   &kp SEMI &mt RSHFT SQT
   &kp LCTRL &kp Z  &kp X  &kp C  &kp V   &kp B   &mo 3        &mo 3       &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &mt RCTRL BSLH
                      &kp LGUI &kp LALT  &mo 1    &kp RET      &kp SPACE    &mo 2  &kp RALT &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "Lower";

/* -----------------------------------------------------------------|    |--------------------------------------------------------------------------|
 0|    ~    |    F1    |   F2     |   F3   |  F4    |  F5 |         |    |          |   F6      |  F7  |      F8     |  F9      |  F10    |   +     |
12|    `    |          |   HOME   |        |  END   |     |         |    |          |           | Pg Up|     Insert  |          | PSCRN   |   =     |
24|         |          |          |        |        |     |ink-disp |    | [knob]   | Left      | Down |      Up     | Right    |   [     |   ]     |
38|         |          |          |        |        |     |Adj Layer|    | Adj Layer| Mute      |Pg Dwn|             |          |   {     |   }     |
52|                                                                 |    |                                                                          |
   -----------------------------------------------------------------|    |---------------------------------------------------------------------------*/

            bindings = <
   &kp TILDE &kp F1     &kp F2     &kp F3   &kp F4    &kp F5                         &kp F6      &kp F7     &kp F8    &kp F9     &kp F10   &kp PLUS
   &kp GRAVE &trans     &kp HOME   &trans   &kp END   &trans                         &trans      &kp PG_UP  &kp INS   &trans     &kp PSCRN &kp EQUAL
   &trans    &trans     &trans     &trans   &trans    &trans  &trans       &trans    &kp LEFT    &kp DOWN   &kp UP    &kp RIGHT  &kp LBKT  &kp RBKT
   &trans    &trans     &trans     &trans   &trans    &trans  &trans       &trans    &kp C_MUTE  &kp PG_DN  &trans    &trans     &kp LBRC  &kp RBRC
                                   &trans   &trans    &trans  &trans       &trans    &trans      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };


        raise_layer {
            display-name = "Raise Layer";
// ------------------------------------------------------------------------------------------------------------
// |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |OUTTOG|OUTUSB| OUTBT |      | RESET | FLASH |
// |     | INS  | PSCR | GUI   | RESET |      |                | PGUP |      |   ^   |      |       |       |
// |     | ALT  | CTRL | SHIFT | FLASH | CAPS |      |  |      | PGDN |   <- |   v   |  ->  |  DEL  | BSPC  |
// |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |  |>  |  <|<| | |>|> |       |       |
//                     |       |       |      |      |  |      |      |      |       |
            bindings = <
&bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &out OUT_TOG  &out OUT_USB  &out OUT_BLE  &trans     &sys_reset  &bootloader
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &sys_reset       &studio_unlock                          &kp PG_UP     &trans        &kp UP        &trans     &trans  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &bootloader  &kp CLCK     &trans   &trans    &kp PG_DN     &kp LEFT      &kp DOWN      &kp RIGHT  &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans       &trans   &trans    &trans        &kp C_PP      &kp C_PREV    &kp C_NEXT &trans  &trans
                                     &trans       &trans       &mo 3       &trans   &trans    &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
        adjust_layer {
            display-name = "Adjust Layer";
// ------------------------------------------------------------------------------------------------------------
// |     |     |     |      |      |      |                   |      |       |       |      |       |       |
// |  Z  |     |  ↑  |      |      | SCL↑ |                   |      |       |       |      |       |   =   |
// |     |  ←  |  ↓  |  →   |      | SCL↓ |        |  |       |      |       |       |      |       |       |
// |     |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                   | LCLK | RCLK |      |        |  |       |      |       |       |
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans  &trans  &trans  &trans     &trans  &trans
&kp Z  &trans &mmv MOVE_UP &trans &trans &msc SCRL_UP                    &trans  &trans  &trans  &trans     &trans  &kp EQUAL
&trans     &mmv MOVE_LEFT     &mmv MOVE_DOWN    &mmv MOVE_RIGHT    &trans  &msc SCRL_DOWN     &trans   &trans    &trans     &trans      &trans      &trans  &trans &trans
&trans     &trans   &trans    &trans   &trans  &trans       &trans   &trans    &trans        &trans      &trans    &trans &trans  &trans
                                     &mkp LCLK       &mkp RCLK       &trans       &trans   &trans    &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
        extra_layer {
            display-name = "Extra Layer";
// ------------------------------------------------------------------------------------------------------------
// |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |OUTTOG|OUTUSB| OUTBT |      | RESET | FLASH |
// |     | INS  | PSCR | GUI   | RESET |      |                | PGUP |      |   ^   |      |       |       |
// |     | ALT  | CTRL | SHIFT | FLASH | CAPS |      |  |      | PGDN |   <- |   v   |  ->  |  DEL  | BSPC  |
// |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |  |>  |  <|<| | |>|> |       |       |
//                     |       |       |      |      |  |      |      |      |       |
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans  &trans  &trans  &trans     &trans  &trans
&trans &trans &mmv MOVE_UP &trans &trans &msc SCRL_UP                    &trans  &trans  &trans  &trans     &trans  &trans
&trans     &mmv MOVE_LEFT     &mmv MOVE_DOWN    &mmv MOVE_RIGHT    &trans  &msc SCRL_DOWN     &trans   &trans    &trans     &trans      &trans      &trans  &trans &trans
&trans     &trans   &trans    &trans   &trans  &trans       &trans   &trans    &trans        &trans      &trans    &trans &trans  &trans
                                     &mkp LCLK       &mkp RCLK       &trans       &trans   &trans    &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
};
